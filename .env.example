DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/your_database
APP_NAME=Transactions Query API
DEBUG=false
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
CORS_ORIGINS=http://localhost:5173
# Credenciais do querybuscas; nunca publique estes valores no Git.
QUERYBUSCAS_BASE_URL=https://querybuscas.com
QUERYBUSCAS_USERNAME=
QUERYBUSCAS_PASSWORD=
QUERYBUSCAS_MAX_RETRIES=2
QUERYBUSCAS_RETRY_DELAY_SECONDS=2
S3_ENDPOINT=https://storage.googleapis.com
S3_REGION=southamerica-east1
S3_BUCKET=
S3_PREFIX=backups
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
QUERYBUSCAS_TIMEOUT_SECONDS=15
